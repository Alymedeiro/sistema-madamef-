NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/madame_test
# Cloudflare Turnstile da página /agendar. Sem a secreta, a verificação é pulada.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# WhatsApp (Z-API), só no servidor (nunca NEXT_PUBLIC_). Sem elas o envio fica parado ("sem chaves").
# ZAPI_WEBHOOK_TOKEN: texto aleatório, o mesmo usado na URL do webhook "Ao receber" da Z-API.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_TOKEN=
# Z-API Omni (canal WhatsApp Web): quando as duas estão definidas, o envio usa a Omni
# no lugar de ZAPI_INSTANCE_ID/ZAPI_TOKEN/ZAPI_CLIENT_TOKEN. OMNI_SECRET_KEY: painel Omni >
# Segurança (Secret Key). OMNI_CHANNEL_ID: "ID do canal" na tela do canal.
OMNI_SECRET_KEY=
OMNI_CHANNEL_ID=
